MYSQL_DATABASE=codepath
MYSQL_USER=codepath
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
REDIS_PASSWORD=change-redis-password
INTERNAL_SERVICE_TOKEN=change-internal-token
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=admin@codepath.local
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-admin-password
NEO4J_PASSWORD=replace-neo4j-password
WORKER_MAX_ATTEMPTS=3

# 从宿主机运行根目录 Python 管理/BKT 工具时使用的映射端口
MYSQL_HOST=localhost
MYSQL_PORT=3307
REDIS_HOST=localhost
REDIS_PORT=6380
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j

# DeepSeek（不要把真实密钥提交到 Git）
LLM_BASE_URL=https://api.deepseek.com
