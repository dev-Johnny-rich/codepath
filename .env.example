# ========================================
# Codepath 环境变量配置模板
# ========================================
#
# 使用说明:
# 1. 复制此文件并重命名为 .env
# 2. 填写实际的密码和配置信息
# 3. .env 文件不会被提交到 Git（已在 .gitignore 中）
#

# ========================================
# MySQL 数据库配置
# ========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=codepath

# ========================================
# Neo4j 图数据库配置
# ========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ========================================
# Redis 缓存配置
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========================================
# 应用配置
# ========================================
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# ========================================
# BKT 算法参数（可选，留空使用默认值）
# ========================================
BKT_P_INIT=0.0
BKT_P_LEARN=0.3
BKT_P_SLIP=0.1
BKT_P_GUESS=0.2
