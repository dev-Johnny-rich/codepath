# ========================================
# Codepath 根目录 Python 工具的兼容配置模板
# ========================================
#
# 使用说明:
# 新项目请优先使用 codepath-backend/.env.example。
# 仅在需要独立运行根目录 Python 工具时：
# 1. 复制此文件并重命名为 .env
# 2. 填写实际的密码和配置信息
# 3. 运行时设置 CODEPATH_ENV_FILE=.env
# 4. .env 文件不会被提交到 Git（已在 .gitignore 中）
#

# ========================================
# MySQL 数据库配置
# ========================================
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=codepath
MYSQL_PASSWORD=codepath-dev
MYSQL_DATABASE=codepath

# ========================================
# Neo4j 图数据库配置
# ========================================
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=codepath-neo4j

# ========================================
# Redis 缓存配置
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis-dev
REDIS_DB=0

# ========================================
# 应用配置
# ========================================
DEBUG=True
APP_ENV=development
JWT_SECRET=codepath-dev-jwt-secret-change-before-production-2026

# ========================================
# BKT 算法参数（可选，留空使用默认值）
# ========================================
BKT_P_INIT=0.15
BKT_P_LEARN=0.25
BKT_P_SLIP=0.1
BKT_P_GUESS=0.2
